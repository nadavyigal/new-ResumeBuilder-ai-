# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/

# next.js
/.next/
.next/
/out/

# production
/build
dist/

# misc
.DS_Store
*.pem

# env files (can opt-in for committing if needed)
.env*
!.env.example
!/env.example

# Artifacts (local only)
/tmp/artifacts/**
/.playwright-mcp/
vercel-latest-deploy.png

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Temporary directories
AI/
playground/
ResumeBuilder AI/
resume-builder-ai/
ios/

# Windows reserved filenames
nul
resume-builder-ai/nul
.env*.local

# Eval run artifacts (regenerated each run)
evals/**/report.json

# iCloud sync duplicates ("route 2.ts", "en 2.json") — always stale copies of a
# tracked file, and anything reading by glob picks up the wrong version.
* [0-9].*
